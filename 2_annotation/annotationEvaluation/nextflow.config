// post-annotation evaluation pipeline 
manifest {
    name          = 'postEviann-eval'
    description    = 'Evaluate & plot post-annotation'
    mainScript     = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

// bioconda / conda-forge
conda.channels = ['conda-forge', 'bioconda']

process {
    cpus = 2
    memory = '4 GB'
    time = '12.h'
    // Evaluations are independent: let a broken one drop out rather than
    // aborting the branches that would otherwise finish.
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
    maxRetries    = 3

    withLabel: psauron {
        cpus   = 8
        memory = '32 GB'
        time   = '12.h'
    }
    withLabel: compleasm {
        cpus   = 16
        memory = '32 GB'
        time   = '12.h'
    }
    withLabel: omark {
        cpus   = 16
        memory = '64 GB'
        time   = '24.h'
    }
    withLabel: agat {
        cpus   = 4
        memory = '64 GB'
        time   = '24.h'
    }
    withLabel: python {
        cpus   = 2
        memory = '32 GB'
        time   = '8.h'
    }
    withLabel: plot {
        cpus   = 2
        memory = '16 GB'
        time   = '6.h'
    }
    withLabel: plot_r {
        cpus   = 4
        memory = '64 GB'
        time   = '12.h'
    }
}

profiles {
    // default: one conda env per process (from inline `conda` directives)
    conda {
        conda.enabled = true
    }
    docker {
        docker.enabled = true
        conda.enabled  = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
    }
    // HPC: submit each process as a Slurm job
    slurm {
        process {
            executor       = 'slurm'
            queue          = 'newicelake'
            clusterOptions = ''
        }
        executor {
            queueSize       = 50
            submitRateLimit = '10/1min'
            pollInterval    = '30 sec'
        }
    }
    // offline DAG validation
    stub {
        conda.enabled = false
    }
}
// NB: pick profile(s) at run time, e.g.
//   -profile conda
//   -profile slurm,conda          (HPC + conda envs)
//   -profile stub -stub-run       (offline DAG check)
